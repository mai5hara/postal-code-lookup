{
  "name": "ensapia-coding-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
